<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<ProxyEndpoint name="default">
  <Description/>
  <FaultRules>
    <FaultRule name="AuthenticationFaults">
      <Step>
        <Name>AM-Fault-Auth</Name>
      </Step>
      <Condition>(error.status.code = 401) or (error.status.code = 403)</Condition>
    </FaultRule>
    <FaultRule name="ClientFaults">
      <Step>
        <Name>AM-Fault-Client</Name>
      </Step>
      <Condition>(error.status.code &gt;= 400) and (error.status.code &lt; 500)</Condition>
    </FaultRule>
  </FaultRules>
  <DefaultFaultRule name="DefaultFaultRule">
    <Step>
      <Name>AM-Fault-Server</Name>
    </Step>
    <AlwaysEnforce>true</AlwaysEnforce>
  </DefaultFaultRule>
  <PreFlow name="PreFlow">
    <Request>
      <Step>
        <Name>RF-Simulate-503</Name>
      </Step>
      <Step>
        <Name>VA-API-Key</Name>
      </Step>
    </Request>
    <Response/>
  </PreFlow>
  <Flows>
    <Flow name="GetOrder">
      <Description/>
      <Request>
        <Step>
          <Name>SC-Order-Enrichment</Name>
        </Step>
        <Step>
          <Name>AM-Operation-Header</Name>
        </Step>
        <Step>
          <Name>EV-Order-Id</Name>
        </Step>
      </Request>
      <Response>
        <Step>
          <Name>AM-Enrichment-Header</Name>
        </Step>
      </Response>
      <Condition>(proxy.pathsuffix MatchesPath "/orders/broken-orders") and (request.verb = "GET")</Condition>
    </Flow>
    <Flow name="CreateOrder">
      <Description/>
      <Request>
        <Step>
          <Name>AM-Create-Operation-Header</Name>
        </Step>
      </Request>
      <Response/>
      <Condition>(proxy.pathsuffix MatchesPath "/orders") and (request.verb = "POST")</Condition>
    </Flow>
  </Flows>
  <PostFlow name="PostFlow">
    <Request>
    </Request>
    <Response>
    </Response>
  </PostFlow>
  <HTTPProxyConnection>
    <BasePath>/orders/v1</BasePath>
    <Properties/>
  </HTTPProxyConnection>
  <RouteRule name="default">
    <TargetEndpoint>default</TargetEndpoint>
  </RouteRule>
</ProxyEndpoint>
