<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<AssignMessage name="AM-Create-Correlation">
  <AssignVariable>
    <Name>flow.correlationId</Name>
    <Template>{system.uuid}</Template>
  </AssignVariable>
  <Set>
    <Headers>
      <Header name="x-correlation-id">{flow.correlationId}</Header>
      <Header name="x-api-standard">training-v1</Header>
    </Headers>
  </Set>
</AssignMessage>
